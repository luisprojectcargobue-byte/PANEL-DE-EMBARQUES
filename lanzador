    text-transform:uppercase;
  }
  .brand-title{ font-size:32px; font-weight:700; margin-top:4px; }
  .clock-block{ text-align:right; }
  .clock{ font-family:var(--mono); font-size:40px; font-weight:600; font-variant-numeric:tabular-nums; }
  .date-line{ font-family:var(--mono); font-size:13px; color:var(--ink-dim); margin-top:6px; text-transform:uppercase; letter-spacing:1px; }

  .grid{
    display:grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 22px;
  }
  @media (max-width: 900px){ .grid{ grid-template-columns: 1fr; } }

  .card{
    background:var(--bg-panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:22px 24px;
    box-shadow:0 1px 3px rgba(15,27,42,0.06);
  }
  .card h2{
    font-size:15px;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:var(--ink-dim);
    margin-bottom:16px;
    display:flex;
    align-items:center;
    gap:8px;
  }

  /* ---------- Checklist ---------- */
  .check-item{
    display:flex;
    align-items:center;
    gap:12px;
    padding:11px 0;
    border-bottom:1px solid var(--line);
    font-size:17px;
  }
  .check-item:last-child{ border-bottom:none; }
  .check-item .bullet{
    width:8px; height:8px;
    border-radius:50%;
    background: var(--ink-dim);
    flex-shrink:0;
  }

  /* ---------- Feriados ---------- */
  .feriado-item{
    display:flex;
    align-items:center;
    gap:14px;
    padding:12px 0;
    border-bottom:1px solid var(--line);
  }
  .feriado-item:last-child{ border-bottom:none; }
  .feriado-fecha{
    font-family:var(--mono);
    font-size:15px;
    font-weight:700;
    min-width:74px;
    text-align:center;
    padding:6px 8px;
    border-radius:6px;
    color:#fff;
  }
  .feriado-fecha.ar{ background:var(--blue); }
  .feriado-fecha.br{ background:var(--teal); }
  .feriado-info .nombre{ font-weight:600; font-size:15px; }
  .feriado-info .pais{ font-size:12px; color:var(--ink-dim); font-family:var(--mono); }
  .feriado-proximo{
    display:inline-block;
    margin-left:8px;
    font-family:var(--mono);
    font-size:11px;
    font-weight:700;
    color:var(--red);
    background:rgba(224,32,26,0.1);
    padding:2px 8px;
    border-radius:4px;
  }

  /* ---------- Contactos ---------- */
  .contacto-item{
    padding:12px 0;
    border-bottom:1px solid var(--line);
  }
  .contacto-item:last-child{ border-bottom:none; }
  .contacto-rol{ font-family:var(--mono); font-size:11px; letter-spacing:1px; text-transform:uppercase; color:var(--ink-dim); }
  .contacto-nombre{ font-weight:600; font-size:16px; margin-top:2px; }
  .contacto-tel{ font-family:var(--mono); font-size:14px; color:var(--ink-dim); margin-top:2px; }
  .vacio{ color:var(--ink-dim); font-size:14px; padding:10px 0; }

  .btn-editar{
    font-family:var(--mono);
    font-size:12px;
    font-weight:600;
    padding:8px 14px;
    border-radius:6px;
    border:1px solid var(--line);
    background:#fff;
    color:var(--ink);
    cursor:pointer;
    margin-top:14px;
  }
  .btn-editar:hover{ border-color:var(--ink-dim); }

  /* ---------- Modal contactos ---------- */
  .modal-overlay{
    display:none; position:fixed; inset:0; background:rgba(15,27,42,0.5);
    z-index:50; align-items:center; justify-content:center; padding:30px;
  }
  .modal-overlay.show{ display:flex; }
  .modal-box{
    background:#fff; border-radius:10px; max-width:640px; width:100%;
    max-height:88vh; overflow-y:auto; padding:26px 30px;
    box-shadow:0 10px 40px rgba(15,27,42,0.25);
  }
  .modal-box h3{ font-size:18px; margin-bottom:6px; }
  .modal-sub{ color:var(--ink-dim); font-size:13px; margin-bottom:16px; }
  .modal-box textarea{
    width:100%; min-height:180px; font-family:var(--mono); font-size:13px;
    border:1px solid var(--line); border-radius:6px; padding:10px; resize:vertical; color:var(--ink);
  }
  .modal-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:14px; }
  .modal-actions button{
    font-family:var(--mono); font-size:13px; font-weight:700; padding:9px 18px;
    border-radius:6px; cursor:pointer; border:none;
  }
  .btn-guardar{ background:var(--ink); color:#fff; }
  .btn-cerrar{ background:var(--line); color:var(--ink); }
</style>
</head>
<body>

  <div class="header">
    <div>
      <div class="brand-eyebrow">Fin de jornada · BA → Brasil</div>
      <div class="brand-title">Cierre de Oficina</div>
    </div>
    <div class="clock-block">
      <div class="clock" id="clock">--:--</div>
      <div class="date-line" id="dateline">-</div>
    </div>
  </div>

  <div class="grid">
    <div>
      <div class="card" style="margin-bottom:22px;">
        <h2>✅ Antes de irte</h2>
        <div id="checklist"></div>
      </div>

      <div class="card">
        <h2>📞 Contactos esenciales</h2>
        <div id="contactos"></div>
        <button class="btn-editar" id="btn-editar-contactos">✎ Editar contactos</button>
      </div>
    </div>

    <div class="card">
      <h2>📅 Próximos feriados — Argentina y Brasil</h2>
      <div id="feriados"></div>
    </div>
  </div>

  <div class="modal-overlay" id="modal-contactos-overlay">
    <div class="modal-box">
      <h3>Contactos esenciales</h3>
      <div class="modal-sub">Una línea por contacto, formato: Naviera/Empresa - Teléfono - Nombre. Ejemplo: CMA CGM - 11 2345-6789 - Adriana</div>
      <textarea id="input-contactos" spellcheck="false"></textarea>
      <div class="modal-actions">
        <button class="btn-cerrar" id="btn-cerrar-contactos">Cerrar</button>
        <button class="btn-guardar" id="btn-guardar-contactos">Guardar</button>
      </div>
    </div>
  </div>

<script>
  // ---------- Reloj ----------
  function tickClock(){
    const now = new Date();
    const hh = String(now.getHours()).padStart(2,"0");
    const mm = String(now.getMinutes()).padStart(2,"0");
    document.getElementById("clock").textContent = `${hh}:${mm}`;
    document.getElementById("dateline").textContent = now.toLocaleDateString('es-AR', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
  }
  tickClock();
  setInterval(tickClock, 1000);

  // ============================================================
  // CHECKLIST DE CIERRE — editá esta lista con las tareas reales
  // ============================================================
  const tareas = [
    "Apagar luces de la oficina",
    "Cerrar con llave la puerta principal",
    "Avisar en el grupo del equipo si queda algo pendiente",
    "Chequear que no haya ningún Cut Off crítico sin atender",
    "Apagar el aire acondicionado / calefacción",
  ];

  function renderChecklist(){
    const cont = document.getElementById("checklist");
    cont.innerHTML = "";
    tareas.forEach((t) => {
      const div = document.createElement("div");
      div.className = "check-item";
      div.innerHTML = `<div class="bullet"></div><span class="txt">${t}</span>`;
      cont.appendChild(div);
    });
  }
  renderChecklist();

  // ============================================================
  // FERIADOS — Argentina y Brasil, resto de 2026 (fuente: calendarios oficiales)
  // ============================================================
  const feriados = [
    { fecha: "2026-09-07", pais: "br", nombre: "Independência do Brasil" },
    { fecha: "2026-10-12", pais: "ar", nombre: "Día del Respeto a la Diversidad Cultural" },
    { fecha: "2026-10-12", pais: "br", nombre: "Nossa Senhora Aparecida" },
    { fecha: "2026-11-02", pais: "br", nombre: "Finados" },
    { fecha: "2026-11-15", pais: "br", nombre: "Proclamação da República (domingo)" },
    { fecha: "2026-11-20", pais: "br", nombre: "Consciência Negra" },
    { fecha: "2026-11-23", pais: "ar", nombre: "Día de la Soberanía Nacional (trasladado)" },
    { fecha: "2026-12-07", pais: "ar", nombre: "Puente turístico" },
    { fecha: "2026-12-08", pais: "ar", nombre: "Inmaculada Concepción de María" },
    { fecha: "2026-12-25", pais: "ar", nombre: "Navidad" },
    { fecha: "2026-12-25", pais: "br", nombre: "Natal" },
  ].sort((a,b) => new Date(a.fecha) - new Date(b.fecha));

  function renderFeriados(){
    const cont = document.getElementById("feriados");
    cont.innerHTML = "";
    const hoy = new Date(); hoy.setHours(0,0,0,0);
    let yaMarcoProximo = false;

    feriados
      .filter(f => new Date(f.fecha + "T00:00:00") >= hoy)
      .forEach(f => {
        const fechaObj = new Date(f.fecha + "T00:00:00");
        const dia = fechaObj.toLocaleDateString('es-AR', { day:'2-digit', month:'short' }).toUpperCase();
        const div = document.createElement("div");
        div.className = "feriado-item";
        const etiquetaProximo = !yaMarcoProximo ? `<span class="feriado-proximo">PRÓXIMO</span>` : "";
        yaMarcoProximo = true;
        div.innerHTML = `
          <div class="feriado-fecha ${f.pais}">${dia}</div>
          <div class="feriado-info">
            <div class="nombre">${f.nombre}${etiquetaProximo}</div>
            <div class="pais">${f.pais === "ar" ? "🇦🇷 Argentina" : "🇧🇷 Brasil"}</div>
          </div>
        `;
        cont.appendChild(div);
      });
  }
  renderFeriados();

  // ============================================================
  // CONTACTOS DE GUARDIA — se cargan y editan desde el botón, quedan guardados
  // ============================================================
  function renderContactos(){
    const cont = document.getElementById("contactos");
    let texto = "";
    try{ texto = localStorage.getItem("cierre_contactos") || ""; } catch(e){}
    const lineas = texto.split("\n").map(l => l.trim()).filter(l => l);

    if(lineas.length === 0){
      cont.innerHTML = `<div class="vacio">Todavía no cargaste contactos — usá el botón "Editar contactos"</div>`;
      return;
    }
    cont.innerHTML = "";
    lineas.forEach(l => {
      const partes = l.split(" - ").map(p => p.trim());
      const div = document.createElement("div");
      div.className = "contacto-item";
      div.innerHTML = `
        <div class="contacto-rol">${partes[0] || ""}</div>
        <div class="contacto-nombre">${partes[2] || ""}</div>
        <div class="contacto-tel">${partes[1] || ""}</div>
      `;
      cont.appendChild(div);
    });
  }
  renderContactos();

  const modalContactos = document.getElementById("modal-contactos-overlay");
  const inputContactos = document.getElementById("input-contactos");
  document.getElementById("btn-editar-contactos").addEventListener("click", () => {
    try{ inputContactos.value = localStorage.getItem("cierre_contactos") || ""; } catch(e){}
    modalContactos.classList.add("show");
  });
  document.getElementById("btn-cerrar-contactos").addEventListener("click", () => modalContactos.classList.remove("show"));
  modalContactos.addEventListener("click", (ev) => { if(ev.target === modalContactos) modalContactos.classList.remove("show"); });
  document.getElementById("btn-guardar-contactos").addEventListener("click", () => {
    try{ localStorage.setItem("cierre_contactos", inputContactos.value); } catch(e){}
    renderContactos();
    modalContactos.classList.remove("show");
  });
</script>

</body>
</html>
