  const camposFecha = ["cutOffDoc","etd","eta"];
  function compararPorCampo(a, b, campo, dir, fechaCampo){
    let va, vb;
    if(camposFecha.includes(campo)){
      va = parseFecha(a[campo]); vb = parseFecha(b[campo]);
      return (va - vb) * dir;
    }
    if(campo === "estado"){
      return (ordenEstado[a.estado] - ordenEstado[b.estado]) * dir;
    }
    if(campo === "buque"){
      va = (a.buque + " " + a.viaje).toLowerCase();
      vb = (b.buque + " " + b.viaje).toLowerCase();
      return va.localeCompare(vb, 'es', {numeric:true}) * dir;
    }
    va = (a[campo] || "").toString().toLowerCase();
    vb = (b[campo] || "").toString().toLowerCase();
    return va.localeCompare(vb, 'es', {numeric:true}) * dir;
  }

