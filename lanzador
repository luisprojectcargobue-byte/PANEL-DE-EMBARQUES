<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Lanzador — Panel TV</title>
<style>
  html, body{ margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#0F1B2A; }
  iframe{ width:100%; height:100%; border:none; display:block; }
</style>
</head>
<body>

  <iframe id="pantalla" src=""></iframe>

<script>
  // ============================================================
  // CONFIGURACIÓN — editá esta lista para agregar, quitar o reordenar páginas
  // "archivo": el nombre del .html (tiene que estar en la misma carpeta/repo)
  // "segundos": cuánto tiempo se queda en esa página antes de pasar a la siguiente
  // ============================================================
  const paginas = [
    { archivo: "index.html",          segundos: 300 }, // Panel de embarques: 5 minutos
    { archivo: "cierre-oficina.html", segundos: 30  }, // Cierre de oficina: 30 segundos
  ];

  let indice = 0;
  const iframe = document.getElementById("pantalla");

  function mostrarPagina(){
    iframe.src = paginas[indice].archivo;
    const espera = paginas[indice].segundos * 1000;
    indice = (indice + 1) % paginas.length;
    setTimeout(mostrarPagina, espera);
  }

  mostrarPagina();
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Panel de Cut Off — Seguimiento de Embarques</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');
  :root{
    --bg: #FFFFFF;
    --bg-panel: #F8FAFC;
    --line: #E2E8F0;
    --ink: #0F1B2A;
    --ink-dim: #64748B;
    --amber: #FF8C00;
    --red: #E0201A;
    --teal: #00A86B;
    --mono: 'IBM Plex Mono', 'Courier New', monospace;
    --sans: 'IBM Plex Sans', Arial, sans-serif;
  }

  *{ box-sizing: border-box; margin:0; padding:0; }
  html,body{
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    width:100%; height:100%;
    overflow-x:hidden;
  }
  body{ padding: 28px 40px 40px; }

  /* ---------- Header ---------- */
  .header{
    display:flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
    margin-bottom: 22px;
  }
  .brand-eyebrow{
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--ink-dim);
    text-transform: uppercase;
  }
  .brand-title{
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-top: 4px;
  }
  .clock-block{ text-align:right; }
  .clock{
    font-family: var(--mono);
    font-size: 40px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .date-line{
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-dim);
    margin-top: 6px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* ---------- Summary strip ---------- */
  .summary{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 26px;
  }
  .sum-card{
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-left: 5px solid var(--ink-dim);
    border-radius: 6px;
    padding: 16px 20px;
    display:flex;
    align-items:center;
    justify-content: space-between;
    box-shadow: 0 1px 3px rgba(15,27,42,0.06);
  }
  .sum-card.crit{ border-left-color: var(--red); }
  .sum-card.warn{ border-left-color: var(--amber); }
  .sum-card.ok{ border-left-color: var(--teal); }
  .sum-label{
    font-size: 13px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .sum-number{
    font-family: var(--mono);
    font-size: 40px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .crit .sum-number{ color: var(--red); }
  .warn .sum-number{ color: var(--amber); }
  .ok .sum-number{ color: var(--teal); }

  /* ---------- Table ---------- */
  .panel-title{
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--ink-dim);
    text-transform: uppercase;
    margin-bottom: 10px;
    display:flex;
    align-items:center;
    gap: 10px;
  }
  .panel-title::after{
    content:"";
    flex:1;
    height:1px;
    background: var(--line);
  }

  table{
    width:100%;
    border-collapse: collapse;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15,27,42,0.06);
  }
  thead th{
    text-align:left;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ink-dim);
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    position: sticky;
    top: 0;
    background: var(--bg-panel);
    z-index: 1;
  }
  tbody td{
    padding: 14px 16px;
    font-size: 16px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr.row-crit{ background: rgba(224,32,26,0.08); }
  tbody tr.row-warn{ background: rgba(255,140,0,0.09); }

  .mono{ font-family: var(--mono); }
  .operacion{ font-weight: 600; }
  .cliente{ color: var(--ink-dim); }

  .badge{
    display:inline-flex;
    align-items:center;
    gap:7px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 4px;
  }
  .badge .dot{
    width:8px; height:8px; border-radius:50%;
    background: rgba(255,255,255,0.85);
  }
  .badge.crit{ background: var(--red); color: #fff; }
  .badge.warn{ background: var(--amber); color: #fff; }
  .badge.ok{ background: var(--teal); color: #fff; }

  .countdown{ font-family: var(--mono); font-size: 15px; }

  .footer-note{
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-dim);
    text-align:right;
  }

  /* ---------- Tabs ---------- */
  .tab-dots{
    display:flex;
    gap: 8px;
    align-items:center;
  }
  .tab-dots .tab-dot{
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--line);
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .tab-dots .tab-dot.active{
    background: var(--ink);
    transform: scale(1.25);
  }
  .view{ display:none; animation: fadein 0.5s ease; }
  .view.active{ display:block; }
  @keyframes fadein{ from{ opacity:0; } to{ opacity:1; } }

  .table-scroll{
    max-height: calc(100vh - 330px);
    overflow-y: auto;
    border-radius: 8px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .table-scroll::-webkit-scrollbar{ display:none; }
  .table-scroll table{ box-shadow:none; }

  /* ---------- Buscador ---------- */
  .search-bar{
    display:flex;
    align-items:center;
    gap: 10px;
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 18px;
    box-shadow: 0 1px 3px rgba(15,27,42,0.06);
  }
  .search-bar svg{ flex-shrink:0; }
  .search-bar input{
    flex:1;
    border:none;
    outline:none;
    background: transparent;
    font-family: var(--sans);
    font-size: 16px;
    color: var(--ink);
  }
  .search-bar input::placeholder{ color: var(--ink-dim); }
  .search-clear{
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-dim);
    background: var(--line);
    border-radius: 4px;
    padding: 3px 8px;
    cursor:pointer;
    display:none;
  }
  .search-clear.show{ display:inline-block; }
  .search-count{
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-dim);
    white-space:nowrap;
  }

  /* ---------- Atendido ---------- */
  .chk-cell{ text-align:center; }
  .chk-atendido{
    width: 22px; height: 22px;
    border: 2px solid var(--line);
    border-radius: 5px;
    cursor: pointer;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background: #fff;
    transition: all 0.15s ease;
  }
  .chk-atendido:hover{ border-color: var(--ink-dim); }
  .chk-atendido.checked{
    background: var(--teal);
    border-color: var(--teal);
  }
  .chk-atendido.checked::after{
    content:"✓";
    color:#fff;
    font-size: 14px;
    font-weight: 700;
  }
  tr.atendida{ opacity: 0.4; }
  tr.atendida td:not(.chk-cell){ text-decoration: line-through; }

  /* ---------- Extensión de Cut Off ---------- */
  .ext-add{
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
    border: 1px dashed var(--line);
    border-radius: 5px;
    padding: 4px 8px;
    cursor: pointer;
    white-space: nowrap;
    background: transparent;
  }
  .ext-add:hover{ border-color: var(--ink-dim); color: var(--ink); }
  .ext-badge{
    display:inline-flex;
    align-items:center;
    gap: 5px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: var(--teal);
    border-radius: 4px;
    padding: 5px 9px;
    cursor: pointer;
    max-width: 160px;
  }
  .ext-badge span.txt{
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  /* ---------- Encabezados ordenables ---------- */
  th.sortable{ cursor: pointer; user-select: none; white-space: nowrap; }
  th.sortable:hover{ color: var(--ink); }
  th.sortable .arrow{ font-size: 10px; margin-left: 4px; opacity: 0.4; }
  th.sortable.sort-active .arrow{ opacity: 1; color: var(--ink); }

  /* ---------- Filtros rápidos ---------- */
  .filter-bar{
    display:flex;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .filter-btn{
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink-dim);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-btn:hover{ border-color: var(--ink-dim); }
  .filter-btn.active{
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .filter-btn.active.f-crit{ background: var(--red); border-color: var(--red); }
  .filter-btn.active.f-warn{ background: var(--amber); border-color: var(--amber); }
  .filter-btn.active.f-ok{ background: var(--teal); border-color: var(--teal); }

  /* ---------- Botón y modal de carga de datos ---------- */
  .btn-cargar{
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--bg-panel);
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .btn-cargar:hover{ border-color: var(--ink-dim); }

  .modal-overlay{
    display:none;
    position: fixed;
    inset: 0;
    background: rgba(15,27,42,0.5);
    z-index: 50;
    align-items:center;
    justify-content:center;
    padding: 30px;
  }
  .modal-overlay.show{ display:flex; }
  .modal-box{
    background: #fff;
    border-radius: 10px;
    max-width: 900px;
    width:100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: 28px 32px;
    box-shadow: 0 10px 40px rgba(15,27,42,0.25);
  }
  .modal-box h2{ font-size: 20px; margin-bottom: 4px; }
  .modal-sub{ color: var(--ink-dim); font-size: 13px; margin-bottom: 20px; }
  .modal-section{ margin-bottom: 22px; }
  .modal-section label{
    display:block;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 4px;
  }
  .modal-section .cols-hint{
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-dim);
    margin-bottom: 6px;
  }
  .modal-section textarea{
    width:100%;
    min-height: 110px;
    font-family: var(--mono);
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 10px;
    resize: vertical;
    color: var(--ink);
  }
  .modal-actions{
    display:flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 10px;
  }
  .modal-actions button{
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 6px;
    cursor:pointer;
    border: none;
  }
  .btn-guardar{ background: var(--ink); color:#fff; }
  .btn-cerrar{ background: var(--line); color: var(--ink); }
  .modal-msg{
    font-family: var(--mono);
    font-size: 12px;
    color: var(--teal);
    margin-top: 8px;
    display:none;
  }
  .modal-msg.show{ display:block; }

  /* ---------- Banner de alerta urgente ---------- */
  .alerta-banner{
    display:none;
    align-items:center;
    gap: 14px;
    background: var(--red);
    color: #fff;
    border-radius: 8px;
    padding: 14px 20px;
    margin-bottom: 18px;
    box-shadow: 0 2px 10px rgba(224,32,26,0.35);
  }
  .alerta-banner.show{ display:flex; }
  .alerta-icono{
    font-size: 22px;
    flex-shrink:0;
    animation: pulso 1.4s ease-in-out infinite;
  }
  @keyframes pulso{
    0%, 100%{ transform: scale(1); opacity:1; }
    50%{ transform: scale(1.15); opacity:0.75; }
  }
  .alerta-texto{
    flex:1;
    font-weight: 700;
    font-size: 16px;
  }
  .alerta-cerrar{
    background: rgba(255,255,255,0.2);
    border: none;
    color:#fff;
    font-family: var(--mono);
    font-size: 12px;
    font-weight:700;
    padding: 6px 12px;
    border-radius: 5px;
    cursor:pointer;
    flex-shrink:0;
  }
  .alerta-cerrar:hover{ background: rgba(255,255,255,0.32); }
  .btn-alerta{
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid var(--red);
    background: #fff;
    color: var(--red);
    cursor: pointer;
    white-space: nowrap;
    margin-left: 10px;
  }
  .btn-alerta:hover{ background: rgba(224,32,26,0.06); }
</style>
</head>
<body>

  <div class="header">
    <div>
      <div class="brand-eyebrow">Seguimiento de Embarques · BA → Brasil</div>
      <div class="brand-title" id="brand-title">Panel de Cut Off</div>
    </div>
    <div class="clock-block">
      <div class="clock" id="clock">--:--</div>
      <div class="date-line" id="dateline">-</div>
      <div class="tab-dots" id="tab-dots" style="justify-content:flex-end; margin-top:8px;">
        <div class="tab-dot active" data-tab="0"></div>
        <div class="tab-dot" data-tab="1"></div>
        <div class="tab-dot" data-tab="2"></div>
      </div>
    </div>
    <button class="btn-cargar" id="btn-abrir-modal" style="margin-left:16px;">✎ Cargar datos</button>
    <button class="btn-alerta" id="btn-abrir-alerta">🚨 Alerta urgente</button>
  </div>

  <div class="alerta-banner" id="alerta-banner">
    <span class="alerta-icono">🚨</span>
    <span class="alerta-texto" id="alerta-texto"></span>
    <button class="alerta-cerrar" id="alerta-cerrar">Resuelto ✕</button>
  </div>

  <div class="modal-overlay" id="modal-overlay">
    <div class="modal-box">
      <h2>Cargar datos del día</h2>
      <div class="modal-sub">Copiá las filas directo de Excel (sin encabezado) y pegalas acá. Cada campo separado por tabulador, tal cual sale al copiar celdas de una planilla.</div>

      <div class="modal-section">
        <label>Cut Off</label>
        <div class="cols-hint">Orden: OPERACION · BOOKING · CLIENTE · AGENTE · Tipo Ctr · BUQUE · VIAJE · CUT OFF DOC (M/D/AAAA HH:mm) · Numero MBL</div>
        <textarea id="input-cutoff" spellcheck="false"></textarea>
      </div>

      <div class="modal-section">
        <label>Pre Alertas / Embarques</label>
        <div class="cols-hint">Orden: OPERACION · BOOKING · CLIENTE · AGENTE · Tipo Ctr · BUQUE · VIAJE · ETD (M/D/AAAA HH:mm)</div>
        <textarea id="input-prealertas" spellcheck="false"></textarea>
      </div>

      <div class="modal-section">
        <label>Importación</label>
        <div class="cols-hint">Orden: CMI · SHIPPER · CNEE · ETD (M/D/AAAA HH:mm) · ETA (M/D/AAAA HH:mm) · POL · POD · LINE</div>
        <textarea id="input-importacion" spellcheck="false"></textarea>
      </div>

      <div class="modal-msg" id="modal-msg">✓ Datos cargados y guardados en este navegador</div>
      <div class="modal-actions">
        <button class="btn-cerrar" id="btn-cerrar-modal">Cerrar</button>
        <button class="btn-guardar" id="btn-guardar-modal">Guardar y aplicar</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modal-alerta-overlay">
    <div class="modal-box" style="max-width:520px;">
      <h2>Alerta urgente para todo el equipo</h2>
      <div class="modal-sub">Aparece como banner fijo arriba del dashboard, en cualquier pestaña, sin interrumpir la rotación. Se sincroniza al instante en todas las computadoras que tengan la página abierta, y avisa por Teams a Martín.</div>
      <div class="modal-section">
        <label>Mensaje</label>
        <textarea id="input-alerta" spellcheck="false" style="min-height:70px;" placeholder="Ej: Contenedor CME005209 no ingresó a puerto — urgente coordinar con naviera"></textarea>
      </div>
      <div class="modal-actions">
        <button class="btn-cerrar" id="btn-quitar-alerta">Quitar alerta</button>
        <button class="btn-cerrar" id="btn-cerrar-alerta-modal">Cerrar</button>
        <button class="btn-guardar" id="btn-publicar-alerta" style="background:var(--red);">Publicar alerta</button>
      </div>
    </div>
  </div>

  <div class="search-bar">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input type="text" id="buscador" placeholder="Buscar por cliente, operación, agente, buque o booking...">
    <span class="search-count" id="search-count"></span>
    <span class="search-clear" id="search-clear">Limpiar ✕</span>
  </div>

  <div class="view active" id="view-cutoff">
  <div class="summary">
    <div class="sum-card crit">
      <div>
        <div class="sum-label">Cut off vencido</div>
      </div>
      <div class="sum-number" id="count-crit">0</div>
    </div>
    <div class="sum-card warn">
      <div>
        <div class="sum-label">Cut off en menos de 48 h</div>
      </div>
      <div class="sum-number" id="count-warn">0</div>
    </div>
    <div class="sum-card ok">
      <div>
        <div class="sum-label">Con margen (48 h+)</div>
      </div>
      <div class="sum-number" id="count-ok">0</div>
    </div>
  </div>

  <div class="panel-title">Embarques ordenados por urgencia de Cut Off Doc</div>
  <div class="filter-bar" data-tabla="cutoff">
    <button class="filter-btn active" data-filter="todo">Todo</button>
    <button class="filter-btn f-crit" data-filter="crit">🔴 Urgente</button>
    <button class="filter-btn f-warn" data-filter="warn">🟠 Próximo</button>
    <button class="filter-btn f-ok" data-filter="ok">🟢 Con margen</button>
    <button class="filter-btn" data-filter="atendidos">Atendidos</button>
    <button class="filter-btn" data-filter="pendientes">Pendientes</button>
  </div>
  <div class="table-scroll" id="scroll-cutoff">
  <table>
    <thead>
      <tr>
        <th class="sortable" data-field="operacion">Operación<span class="arrow">↕</span></th>
        <th class="sortable" data-field="booking">Booking<span class="arrow">↕</span></th>
        <th class="sortable" data-field="cliente">Cliente<span class="arrow">↕</span></th>
        <th class="sortable" data-field="agente">Agente<span class="arrow">↕</span></th>
        <th class="sortable" data-field="tipoCtr">Tipo Ctr<span class="arrow">↕</span></th>
        <th class="sortable" data-field="buque">Buque / Viaje<span class="arrow">↕</span></th>
        <th class="sortable" data-field="cutOffDoc">Cut Off Doc<span class="arrow">↕</span></th>
        <th>Extensión</th>
        <th class="sortable" data-field="mbl">Numero MBL<span class="arrow">↕</span></th>
        <th class="sortable" data-field="estado">Estado<span class="arrow">↕</span></th>
        <th>✓</th>
      </tr>
    </thead>
    <tbody id="tbody"></tbody>
  </table>
  </div>

