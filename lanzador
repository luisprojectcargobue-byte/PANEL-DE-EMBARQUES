        <td>
          <span class="badge ${e.estado}"><span class="dot"></span>${badgeLabel}</span>
          <div class="countdown">${e.ext ? e.ext : textoCountdown(e.horas)}</div>
        </td>
        <td class="chk-cell"><div class="chk-atendido ${yaAtendido ? "checked" : ""}" data-rowid="${rowId}"></div></td>
      `;
      tbody.appendChild(tr);
    });

    document.getElementById("count-crit").textContent = crit;
    document.getElementById("count-warn").textContent = warn;
    document.getElementById("count-ok").textContent = ok;
  }

  function renderPreAlertas(){
    const tbody = document.getElementById("tbody-prealertas");
    tbody.innerHTML = "";

    const ordenados = prealertas.map(e => {
      const fecha = parseFecha(e.etd);
      const horas = diffHoras(fecha);
      return { ...e, horas };
    });

    const s = sortState.prealertas;
    if(s.field){
      ordenados.sort((a,b) => compararPorCampo(a,b,s.field,s.dir,"etd"));
    } else {
      ordenados.sort((a,b) => a.horas - b.horas);
    }

    ordenados.forEach(e => {
      const tr = document.createElement("tr");
      const rowId = "pa-" + e.operacion + "-" + e.booking;
      tr.dataset.rowid = rowId;
      tr.dataset.tabla = "prealertas";
      tr.dataset.search = [e.operacion, e.booking, e.cliente, e.agente, e.buque, e.viaje].join(" ").toLowerCase();
      const yaAtendido = atendidos.has(rowId);
      tr.className = yaAtendido ? "atendida" : "";
      tr.innerHTML = `
        <td class="operacion">${e.operacion}</td>
        <td class="mono">${e.booking}</td>
        <td class="cliente">${e.cliente}</td>
        <td>${e.agente}</td>
        <td class="mono">${e.tipoCtr}</td>
        <td class="mono">${e.buque} · ${e.viaje}</td>
        <td class="mono">${e.etd}</td>
        <td class="chk-cell"><div class="chk-atendido ${yaAtendido ? "checked" : ""}" data-rowid="${rowId}"></div></td>
      `;
      tbody.appendChild(tr);
    });
  }

  function renderImportacion(){
    const tbody = document.getElementById("tbody-importacion");
    tbody.innerHTML = "";

    const ordenados = importacion.map(e => {
      const fecha = parseFecha(e.eta);
      const horas = diffHoras(fecha);
      return { ...e, horas };
    });

    const s = sortState.importacion;
    if(s.field){
      ordenados.sort((a,b) => compararPorCampo(a,b,s.field,s.dir,"eta"));
    } else {
      ordenados.sort((a,b) => a.horas - b.horas);
    }

    ordenados.forEach(e => {
      const tr = document.createElement("tr");
      const rowId = "im-" + e.cmi + "-" + e.cnee;
      tr.dataset.rowid = rowId;
      tr.dataset.tabla = "importacion";
      tr.dataset.search = [e.cmi, e.shipper, e.cnee, e.pol, e.pod, e.line].join(" ").toLowerCase();
      const yaAtendido = atendidos.has(rowId);
      tr.className = yaAtendido ? "atendida" : "";
      tr.innerHTML = `
        <td class="operacion">${e.cmi}</td>
        <td>${e.shipper}</td>
        <td class="cliente">${e.cnee}</td>
        <td class="mono">${e.etd}</td>
        <td class="mono">${e.eta}</td>
        <td class="mono">${e.pol}</td>
        <td class="mono">${e.pod}</td>
        <td>${e.line}</td>
        <td class="chk-cell"><div class="chk-atendido ${yaAtendido ? "checked" : ""}" data-rowid="${rowId}"></div></td>
      `;
      tbody.appendChild(tr);
    });

    if(importacion.length === 0){
      tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; color:var(--ink-dim); padding:24px;">Todavía no hay cargas cargadas — pegá los datos en el array "importacion"</td></tr>`;
    }
  }

  function tickClock(){
    const now = new Date();
    const hh = String(now.getHours()).padStart(2,"0");
    const mm = String(now.getMinutes()).padStart(2,"0");
    document.getElementById("clock").textContent = `${hh}:${mm}`;
    const opciones = { weekday:'long', day:'numeric', month:'long', year:'numeric' };
    document.getElementById("dateline").textContent = now.toLocaleDateString('es-AR', opciones);
  }

  // ---------- Rotación de pestañas ----------
  const tabs = [
    { view: "view-cutoff", title: "Panel de Cut Off", dot: 0 },
    { view: "view-prealertas", title: "Pre Alertas / Embarques", dot: 1 },
    { view: "view-importacion", title: "Importación", dot: 2 },
  ];
  let tabIndex = 0;

  function mostrarTab(i){
    tabIndex = i;
    tabs.forEach((t, idx) => {
      document.getElementById(t.view).classList.toggle("active", idx === i);
    });
    document.querySelectorAll(".tab-dot").forEach((d, idx) => {
      d.classList.toggle("active", idx === i);
    });
    document.getElementById("brand-title").textContent = tabs[i].title;
    aplicarFiltros();
  }

  // ---------- Auto-scroll de tablas ----------
  function setupAutoScroll(id, speed=0.6, pauseMs=3000){
    const el = document.getElementById(id);
    let paused = false;
    setInterval(() => {
      if(paused || !el) return;
      if(el.scrollHeight <= el.clientHeight) return; // no hace falta scrollear
      if(el.scrollTop + el.clientHeight >= el.scrollHeight - 1){
        paused = true;
        setTimeout(() => { el.scrollTop = 0; paused = false; }, pauseMs);
      } else {
        el.scrollTop += speed;
      }
    }, 40);
  }

  // ---------- Marcado de "atendido" (persiste en este navegador) ----------
  let atendidos;
  try{
    atendidos = new Set(JSON.parse(localStorage.getItem("panel_atendidos") || "[]"));
  } catch(e){
    atendidos = new Set();
  }
  function guardarAtendidos(){
    try{ localStorage.setItem("panel_atendidos", JSON.stringify([...atendidos])); } catch(e){}
  }
  document.addEventListener("click", (ev) => {
    const chk = ev.target.closest(".chk-atendido");
    if(!chk) return;
    const rowId = chk.dataset.rowid;
    const tr = chk.closest("tr");
    if(atendidos.has(rowId)){
      atendidos.delete(rowId);
      chk.classList.remove("checked");
      tr.classList.remove("atendida");
    } else {
      atendidos.add(rowId);
      chk.classList.add("checked");
      tr.classList.add("atendida");
    }
    guardarAtendidos();
  });

  // ---------- Extensión de Cut Off Doc (persiste en este navegador) ----------
  let extensiones;
  try{
    extensiones = JSON.parse(localStorage.getItem("panel_extensiones") || "{}");
  } catch(e){
    extensiones = {};
  }
  function guardarExtensiones(){
    try{ localStorage.setItem("panel_extensiones", JSON.stringify(extensiones)); } catch(e){}
  }
  document.addEventListener("click", (ev) => {
    const el = ev.target.closest(".ext-add, .ext-badge");
    if(!el) return;
    const rowId = el.dataset.rowid;
    const actual = extensiones[rowId] || "";
    const val = window.prompt("Detalle de la extensión del Cut Off Doc (ej: \"Extendido hasta 30/07 18hs por naviera\"). Dejalo vacío para quitarla:", actual);
    if(val === null) return; // canceló
    if(val.trim() === ""){ delete extensiones[rowId]; } else { extensiones[rowId] = val.trim(); }
    guardarExtensiones();
    render();
    aplicarFiltros();
  });

  // ---------- Filtros rápidos + Buscador (combinados) ----------
  const filtros = { cutoff: "todo", prealertas: "todo", importacion: "todo" };
  const inputBuscar = document.getElementById("buscador");
  const spanCount = document.getElementById("search-count");
  const btnClear = document.getElementById("search-clear");

  function aplicarFiltros(){
    const q = inputBuscar.value.trim().toLowerCase();
    document.querySelectorAll("tbody tr[data-search]").forEach(tr => {
      const tabla = tr.dataset.tabla;
      const filtro = filtros[tabla] || "todo";
      let pasaFiltro = true;
      if(filtro === "atendidos") pasaFiltro = tr.classList.contains("atendida");
      else if(filtro === "pendientes") pasaFiltro = !tr.classList.contains("atendida");
      else if(["crit","warn","ok"].includes(filtro)) pasaFiltro = tr.dataset.estado === filtro;

      const pasaBusqueda = !q || tr.dataset.search.includes(q);
      tr.style.display = (pasaFiltro && pasaBusqueda) ? "" : "none";
    });

    const filasActivas = document.querySelectorAll(".view.active tbody tr[data-search]");
    let total = filasActivas.length, visibles = 0;
    filasActivas.forEach(tr => { if(tr.style.display !== "none") visibles++; });
    btnClear.classList.toggle("show", !!q);
    spanCount.textContent = (q || filasActivas.length && visibles < total)
      ? `${visibles} de ${total} mostrados`
      : "";
  }
  inputBuscar.addEventListener("input", aplicarFiltros);
  btnClear.addEventListener("click", () => { inputBuscar.value = ""; aplicarFiltros(); inputBuscar.focus(); });

  // ---------- Botones de filtro rápido ----------
  document.querySelectorAll(".filter-bar").forEach(bar => {
    const tabla = bar.dataset.tabla;
    bar.querySelectorAll(".filter-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        filtros[tabla] = btn.dataset.filter;
        bar.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        aplicarFiltros();
      });
    });
  });

  // ---------- Orden de columnas al hacer click en el encabezado ----------
  const rerenderPorTabla = { cutoff: render, prealertas: renderPreAlertas, importacion: renderImportacion };
  document.querySelectorAll("th.sortable").forEach(th => {
    th.addEventListener("click", () => {
      const view = th.closest(".view");
      const tabla = view.id === "view-cutoff" ? "cutoff" : (view.id === "view-prealertas" ? "prealertas" : "importacion");
      const campo = th.dataset.field;
      const s = sortState[tabla];
      if(s.field === campo){ s.dir *= -1; } else { s.field = campo; s.dir = 1; }

      th.closest("thead").querySelectorAll("th.sortable").forEach(t => {
        t.classList.remove("sort-active");
        t.querySelector(".arrow").textContent = "↕";
      });
      th.classList.add("sort-active");
      th.querySelector(".arrow").textContent = s.dir === 1 ? "▲" : "▼";

      rerenderPorTabla[tabla]();
      aplicarFiltros();
    });
  });

  // ---------- Modal de carga de datos (pegar directo desde Excel) ----------
  function parsearFilas(texto, campos){
    return texto.split("\n")
      .map(l => l.replace(/\r/g,""))
      .filter(l => l.trim() !== "")
      .map(linea => {
        const partes = linea.split("\t");
        const obj = {};
        campos.forEach((campo, i) => { obj[campo] = (partes[i] || "").trim(); });
        return obj;
      });
  }

  function textoDesdeFilas(filas, campos){
    return filas.map(f => campos.map(c => f[c] || "").join("\t")).join("\n");
  }

  const camposCutoff = ["operacion","booking","cliente","agente","tipoCtr","buque","viaje","cutOffDoc","mbl"];
  const camposPrealertas = ["operacion","booking","cliente","agente","tipoCtr","buque","viaje","etd"];
  const camposImportacion = ["cmi","shipper","cnee","etd","eta","pol","pod","line"];

  const modalOverlay = document.getElementById("modal-overlay");
  const inputCutoffModal = document.getElementById("input-cutoff");
  const inputPrealertasModal = document.getElementById("input-prealertas");
  const inputImportacionModal = document.getElementById("input-importacion");
  const modalMsg = document.getElementById("modal-msg");

  function abrirModal(){
    inputCutoffModal.value = textoDesdeFilas(embarques, camposCutoff);
    inputPrealertasModal.value = textoDesdeFilas(prealertas, camposPrealertas);
    inputImportacionModal.value = textoDesdeFilas(importacion, camposImportacion);
    modalMsg.classList.remove("show");
    modalOverlay.classList.add("show");
  }
  function cerrarModal(){ modalOverlay.classList.remove("show"); }

  document.getElementById("btn-abrir-modal").addEventListener("click", abrirModal);
  document.getElementById("btn-cerrar-modal").addEventListener("click", cerrarModal);
  modalOverlay.addEventListener("click", (ev) => { if(ev.target === modalOverlay) cerrarModal(); });

  document.getElementById("btn-guardar-modal").addEventListener("click", () => {
    embarques = parsearFilas(inputCutoffModal.value, camposCutoff);
    prealertas = parsearFilas(inputPrealertasModal.value, camposPrealertas);
    importacion = parsearFilas(inputImportacionModal.value, camposImportacion);

    try{
      localStorage.setItem("panel_data_cutoff", JSON.stringify(embarques));
      localStorage.setItem("panel_data_prealertas", JSON.stringify(prealertas));
      localStorage.setItem("panel_data_importacion", JSON.stringify(importacion));
    } catch(e){}

    render();
    renderPreAlertas();
    renderImportacion();
    aplicarFiltros();

    modalMsg.classList.add("show");
    setTimeout(() => { cerrarModal(); }, 1200);
  });

  // ---------- Alerta urgente (banner persistente, sincronizado por Firebase, no bloquea el dashboard) ----------
  const alertaBanner = document.getElementById("alerta-banner");
  const alertaTexto = document.getElementById("alerta-texto");
  const alertaOverlay = document.getElementById("modal-alerta-overlay");
  const inputAlerta = document.getElementById("input-alerta");
  const refAlerta = dbFirebase.ref("alertaUrgente");
  let ultimaAlertaConocida = "";

  function pintarAlerta(msg){
    ultimaAlertaConocida = msg || "";
    if(msg && msg.trim()){
      alertaTexto.textContent = msg;
      alertaBanner.classList.add("show");
    } else {
      alertaBanner.classList.remove("show");
    }
  }

  // Escucha cambios en tiempo real — así lo que publica una compu lo ven todas las demás al instante
  refAlerta.on("value", (snap) => {
    const val = snap.val();
    pintarAlerta(val ? val.mensaje : "");
  });

  function abrirModalAlerta(){
    inputAlerta.value = ultimaAlertaConocida;
    alertaOverlay.classList.add("show");
  }
  function cerrarModalAlerta(){ alertaOverlay.classList.remove("show"); }

  document.getElementById("btn-abrir-alerta").addEventListener("click", abrirModalAlerta);
  document.getElementById("btn-cerrar-alerta-modal").addEventListener("click", cerrarModalAlerta);
  alertaOverlay.addEventListener("click", (ev) => { if(ev.target === alertaOverlay) cerrarModalAlerta(); });

  document.getElementById("btn-publicar-alerta").addEventListener("click", () => {
    const msg = inputAlerta.value.trim();
    if(msg){
      refAlerta.set({ mensaje: msg, fecha: new Date().toISOString() });
      avisarPorTeams(msg);
    }
    cerrarModalAlerta();
  });
  document.getElementById("btn-quitar-alerta").addEventListener("click", () => {
    refAlerta.remove();
    inputAlerta.value = "";
    cerrarModalAlerta();
  });
  document.getElementById("alerta-cerrar").addEventListener("click", () => {
    refAlerta.remove();
  });

  render();
  renderPreAlertas();
  renderImportacion();
  aplicarFiltros();
  tickClock();
  mostrarTab(0);
  setInterval(tickClock, 1000);
  setInterval(() => { render(); renderPreAlertas(); renderImportacion(); aplicarFiltros(); }, 60*1000); // re-evalúa urgencias cada 1 min
  setInterval(() => { mostrarTab((tabIndex + 1) % tabs.length); }, 30*1000); // rota de pestaña cada 30 s
  setupAutoScroll("scroll-cutoff");
  setupAutoScroll("scroll-prealertas");
  setupAutoScroll("scroll-importacion");
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Cierre de Oficina — Recordatorios</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');
  :root{
    --bg: #FFFFFF;
    --bg-panel: #F8FAFC;
    --line: #E2E8F0;
    --ink: #0F1B2A;
