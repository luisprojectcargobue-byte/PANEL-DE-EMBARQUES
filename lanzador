  // Parsea "M/D/AAAA HH:mm" (mes/día/año, como llega de la planilla)
  function parseFecha(str){
    const [fecha, hora] = str.trim().split(" ");
    const [m,d,y] = fecha.split("/").map(Number);
    let hh=0, mm=0;
    if(hora){ [hh,mm] = hora.split(":").map(Number); }
    return new Date(y, m-1, d, hh, mm);
  }

  function diffHoras(fecha){
    const ahora = new Date();
    return (fecha - ahora) / 3600000;
  }

  function estadoPorHoras(horas){
    if(horas <= 0) return "crit";
    if(horas <= 48) return "warn";
    return "ok";
  }

  function textoCountdown(horas){
    if(horas <= 0){
      const h = Math.abs(Math.round(horas));
      if(h < 24) return `Venció hace ${h} h`;
      return `Venció hace ${Math.floor(h/24)} día${Math.floor(h/24)===1?"":"s"}`;
    }
    if(horas < 24) return `Vence en ${Math.round(horas)} h`;
    return `Vence en ${Math.floor(horas/24)} día${Math.floor(horas/24)===1?"":"s"}`;
  }

